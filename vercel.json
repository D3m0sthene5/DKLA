{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "outputDirectory": "dist",
  "buildCommand": "node tools/build.mjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "functions": {
    "api/analytics.js": {
      "includeFiles": "lib/analytics/**",
      "maxDuration": 30
    },
    "api/admin.js": {
      "includeFiles": "{lib/analytics/**,assets/admin/index.html}",
      "maxDuration": 30
    },
    "api/sync.js": {
      "includeFiles": "lib/analytics/schema.sql",
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "dkla\\.dev"
        }
      ],
      "destination": "/admin",
      "permanent": false
    },
    {
      "source": "/index.html",
      "has": [
        {
          "type": "host",
          "value": "dkla\\.dev"
        }
      ],
      "destination": "/admin",
      "permanent": false
    },
    {
      "source": "/DKLA-r8.html",
      "destination": "/DKLA-v2.7.html",
      "permanent": false
    },
    {
      "source": "/DKLA-r16.html",
      "destination": "/DKLA-v2.7.html",
      "permanent": false
    },
    {
      "source": "/DKLA-r17.html",
      "destination": "/DKLA-v2.7.html",
      "permanent": false
    },
    {
      "source": "/DKLA-r18.html",
      "destination": "/DKLA-v2.7.html",
      "permanent": false
    },
    {
      "source": "/DKLA-r19.html",
      "destination": "/DKLA-v2.7.html",
      "permanent": false
    },
    {
      "source": "/DKLA-r20.html",
      "destination": "/DKLA-v2.7.html",
      "permanent": false
    },
    {
      "source": "/DKLA-r21.html",
      "destination": "/DKLA-v2.7.html",
      "permanent": false
    },
    {
      "source": "/DKLA-r22.html",
      "destination": "/DKLA-v2.7.html",
      "permanent": false
    },
    {
      "source": "/DKLA-v22.1.html",
      "destination": "/DKLA-v2.7.html",
      "permanent": false
    },
    {
      "source": "/DKLA-v23.html",
      "destination": "/DKLA-v2.7.html",
      "permanent": false
    },
    {
      "source": "/DKLA-v24.html",
      "destination": "/DKLA-v2.7.html",
      "permanent": false
    },
    {
      "source": "/DKLA-v25.html",
      "destination": "/DKLA-v2.7.html",
      "permanent": false
    },
    {
      "source": "/DKLA-v2.4.html",
      "destination": "/DKLA-v2.7.html",
      "permanent": false
    },
    {
      "source": "/DKLA-v2.5.html",
      "destination": "/DKLA-v2.7.html",
      "permanent": false
    },
    {
      "source": "/DKLA-v2.6.html",
      "destination": "/DKLA-v2.7.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/api/admin?action=page"
    },
    {
      "source": "/",
      "destination": "/DKLA-v2.7.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/added-sources/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/assets/admin/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ]
}
