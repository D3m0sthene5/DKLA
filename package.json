{
  "name": "dkla",
  "private": true,
  "type": "module",
  "description": "Danny Kind Legal Atlas: static atlas with first-party analytics, private admin and ratings sync",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "node tools/build.mjs",
    "check": "node tools/check.mjs",
    "preview": "node tools/preview.mjs",
    "source": "node tools/source-cli.mjs",
    "test:analytics": "node --test tools/analytics/analytics.test.mjs",
    "check:analytics": "node tools/analytics/check.mjs",
    "build:analytics": "node tools/analytics/prepare.mjs",
    "test:home": "playwright test tools/v25/home-fit.spec.mjs",
    "check:content": "node tools/verify/check.mjs",
    "smoke": "node tools/verify/smoke.mjs",
    "views": "node tools/verify/views.mjs",
    "views:update": "node tools/verify/views.mjs --update",
    "coverage": "node tools/verify/coverage/run.mjs",
    "lint:survey": "node tools/verify/lint.mjs",
    "verify": "node tools/verify/all.mjs",
    "verify:teeth": "node tools/verify/break.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "@vercel/blob": "^2.8.0",
    "pdfjs-dist": "5.4.624"
  },
  "devDependencies": {
    "@ast-grep/napi": "0.50.0",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "1.64.0",
    "acorn": "8.15.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.6.2",
    "typescript": "7.0.2"
  }
}
