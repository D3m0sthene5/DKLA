# Set privately in Vercel for the intended environment. Never commit real values.
DATABASE_URL=
ANALYTICS_SECRET=
ANALYTICS_ADMIN_PASSWORD_HASH=
# Optional alternative to the scrypt hash: a server-only password of at least 16 characters.
# ANALYTICS_ADMIN_PASSWORD=
ANALYTICS_STORAGE_LIMIT_MB=1000
ANALYTICS_AUTO_COMPACT=false
# Built-in reduced tier: EEA and UK. Optional comma-separated additional ISO country codes.
ANALYTICS_REDUCED_COUNTRIES=
ANALYTICS_NONE_COUNTRIES=
# Existing ratings sync settings remain separate.
BLOB_READ_WRITE_TOKEN=
# DKLA_BLOB_ACCESS=private
# Optional return email. Disabled until explicitly enabled and configured.
ANALYTICS_EMAIL_ENABLED=false
RESEND_API_KEY=
ANALYTICS_ALERT_EMAIL_FROM=
ANALYTICS_ALERT_EMAIL_TO=

# Set to true in Vercel Production after setting a project AI Gateway budget.
DKLA_ASK_GATEWAY_OIDC=false
# Optional alternative for local or preview use. Use a dedicated budget-limited key.
DKLA_ASK_GATEWAY_API_KEY=
